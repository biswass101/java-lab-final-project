<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${title} - City Hospital</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="<%= request.getContextPath() %>/assets/style.css?v=20260614b">
</head>
<body class="min-h-screen bg-slate-100 text-slate-800">
<div class="min-h-screen flex">
  <aside class="w-64 bg-[#0b2545] text-slate-100 p-4 hidden md:flex md:flex-col">
    <div class="text-xl font-semibold tracking-wide px-2 py-3 border-b border-slate-700/60 flex items-center gap-2">
      <i class="bi bi-hospital text-[#1ca39a]"></i>
      <span>City Hospital</span>
    </div>
    <nav class="mt-4 space-y-1 text-sm">
      <a href="${pageContext.request.contextPath}/app/dashboard" class="block px-3 py-2 rounded ${page == 'dashboard' ? 'bg-[#1a3a63] text-white' : 'text-slate-300 hover:bg-[#1a3a63] hover:text-white'}"><i class="bi bi-speedometer2 mr-2"></i>Dashboard</a>
      <a href="${pageContext.request.contextPath}/app/doctors" class="block px-3 py-2 rounded ${page == 'doctors' ? 'bg-[#1a3a63] text-white' : 'text-slate-300 hover:bg-[#1a3a63] hover:text-white'}"><i class="bi bi-person-badge mr-2"></i>Doctor Management</a>
      <a href="${pageContext.request.contextPath}/app/patients" class="block px-3 py-2 rounded ${page == 'patients' ? 'bg-[#1a3a63] text-white' : 'text-slate-300 hover:bg-[#1a3a63] hover:text-white'}"><i class="bi bi-people mr-2"></i>Patient Management</a>
      <a href="${pageContext.request.contextPath}/app/appointments" class="block px-3 py-2 rounded ${page == 'appointments' ? 'bg-[#1a3a63] text-white' : 'text-slate-300 hover:bg-[#1a3a63] hover:text-white'}"><i class="bi bi-calendar-check mr-2"></i>Appointments</a>
      <a href="${pageContext.request.contextPath}/app/prescriptions" class="block px-3 py-2 rounded ${page == 'prescriptions' ? 'bg-[#1a3a63] text-white' : 'text-slate-300 hover:bg-[#1a3a63] hover:text-white'}"><i class="bi bi-file-medical mr-2"></i>Prescriptions</a>
      <a href="${pageContext.request.contextPath}/app/billing" class="block px-3 py-2 rounded ${page == 'billing' ? 'bg-[#1a3a63] text-white' : 'text-slate-300 hover:bg-[#1a3a63] hover:text-white'}"><i class="bi bi-receipt mr-2"></i>Billing</a>
      <a href="${pageContext.request.contextPath}/app/search" class="block px-3 py-2 rounded ${page == 'search' ? 'bg-[#1a3a63] text-white' : 'text-slate-300 hover:bg-[#1a3a63] hover:text-white'}"><i class="bi bi-search mr-2"></i>Search Records</a>
      <a href="${pageContext.request.contextPath}/app/settings" class="block px-3 py-2 rounded ${page == 'settings' ? 'bg-[#1a3a63] text-white' : 'text-slate-300 hover:bg-[#1a3a63] hover:text-white'}"><i class="bi bi-gear mr-2"></i>Admin Settings</a>
    </nav>
    <div class="mt-auto pt-4">
      <a href="${pageContext.request.contextPath}/logout" class="block px-3 py-2 rounded text-rose-200 hover:bg-rose-900/40"><i class="bi bi-box-arrow-right mr-2"></i>Logout</a>
    </div>
  </aside>

  <div class="flex-1 min-w-0 flex flex-col">
    <header class="bg-white border-b border-slate-200 px-6 py-4">
      <h1 class="text-2xl font-semibold text-[#0b2545]">${title}</h1>
    </header>
    <main class="flex-1 p-6 space-y-6 overflow-x-auto">
